# Copy to .env and adjust. All values are optional; defaults shown.

# Regex for the student ID (default: exactly 7 digits)
STUDENT_ID_REGEX=(?<!\d)\d{7}(?!\d)

# Comma-separated keywords that identify a card
CARD_KEYWORDS=元智大學,學生證,STUDENTIDCARD,YUANZEUNIVERSITY,YUANZE,學號
# Minimum number of keywords that must match
MIN_KEYWORDS=2

# Upload limit in bytes (8 MB) and max image side in pixels
MAX_UPLOAD_BYTES=8388608
MAX_IMAGE_SIDE=1600

# Below this OCR score the ID is flagged unreliable
MIN_ID_SCORE=0.80

# Comma-separated allowed CORS origins
CORS_ORIGINS=*
